
using System;
using System.ComponentModel;
using System.Drawing;
using System.Windows.Forms;

namespace Bai47
{
    public class Product
    {
        public string ProductId { get; set; }
        public string ProductName { get; set; }
        public decimal Price { get; set; }
    }

    public class FormProduct : Form
    {
        private FormMain main;

        private BindingList<Product> list =
            new BindingList<Product>();

        private BindingSource source =
            new BindingSource();

        private TextBox txtId = new TextBox();
        private TextBox txtName = new TextBox();
        private TextBox txtPrice = new TextBox();

        private DataGridView dgv = new DataGridView();

        private Button btnAdd = new Button();
        private Button btnDelete = new Button();
        private Button btnRefresh = new Button();

        public FormProduct(FormMain parent)
        {
            main = parent;

            Text = "Quản lý Sản phẩm";
            Size = new Size(820, 550);
            MinimumSize = new Size(650, 440);

            CreateUI();
            CreateContextMenu();
            LoadSampleData();
        }

        private void AddLabel(string text, int x, int y)
        {
            Label lbl = new Label();
            lbl.Text = text;
            lbl.Location = new Point(x, y);
            lbl.AutoSize = true;
            Controls.Add(lbl);
        }

        private void CreateUI()
        {
            Font = new Font("Segoe UI", 10);

            Label title = new Label();
            title.Text = "QUẢN LÝ SẢN PHẨM";
            title.Font = new Font(
                "Segoe UI", 16, FontStyle.Bold);
            title.Dock = DockStyle.Top;
            title.Height = 50;
            title.TextAlign = ContentAlignment.MiddleCenter;
            Controls.Add(title);

            AddLabel("Mã SP:", 20, 75);
            txtId.Location = new Point(130, 72);
            txtId.Width = 180;
            Controls.Add(txtId);

            AddLabel("Tên SP:", 350, 75);
            txtName.Location = new Point(440, 72);
            txtName.Width = 280;
            Controls.Add(txtName);

            AddLabel("Đơn giá:", 20, 125);
            txtPrice.Location = new Point(130, 122);
            txtPrice.Width = 180;
            Controls.Add(txtPrice);

            btnAdd.Text = "Thêm";
            btnAdd.Location = new Point(130, 180);
            btnAdd.Size = new Size(120, 35);

            btnDelete.Text = "Xóa";
            btnDelete.Location = new Point(280, 180);
            btnDelete.Size = new Size(120, 35);

            btnRefresh.Text = "Làm mới";
            btnRefresh.Location = new Point(430, 180);
            btnRefresh.Size = new Size(120, 35);

            Controls.Add(btnAdd);
            Controls.Add(btnDelete);
            Controls.Add(btnRefresh);

            dgv.Location = new Point(20, 235);
            dgv.Size = new Size(760, 255);

            dgv.Anchor = AnchorStyles.Top |
                         AnchorStyles.Bottom |
                         AnchorStyles.Left |
                         AnchorStyles.Right;

            dgv.ReadOnly = true;
            dgv.AllowUserToAddRows = false;
            dgv.AllowUserToDeleteRows = false;
            dgv.MultiSelect = false;
            dgv.SelectionMode =
                DataGridViewSelectionMode.FullRowSelect;
            dgv.AutoSizeColumnsMode =
                DataGridViewAutoSizeColumnsMode.Fill;

            source.DataSource = list;
            dgv.DataSource = source;

            Controls.Add(dgv);

            btnAdd.Click += BtnAdd_Click;
            btnDelete.Click += BtnDelete_Click;

            btnRefresh.Click += delegate
            {
                RefreshList();
            };
        }

        private void LoadSampleData()
        {
            list.Add(new Product
            {
                ProductId = "SP001",
                ProductName = "Laptop Dell",
                Price = 15000000
            });

            list.Add(new Product
            {
                ProductId = "SP002",
                ProductName = "iPhone 15",
                Price = 18000000
            });

            list.Add(new Product
            {
                ProductId = "SP003",
                ProductName = "Chuột Logitech",
                Price = 350000
            });
        }

        private void BtnAdd_Click(
            object sender, EventArgs e)
        {
            string id = txtId.Text.Trim();
            string name = txtName.Text.Trim();

            decimal price;

            if (id == "" || name == "")
            {
                MessageBox.Show(
                    "Nhập đầy đủ thông tin sản phẩm!");
                return;
            }

            if (!decimal.TryParse(
                txtPrice.Text, out price) || price <= 0)
            {
                MessageBox.Show(
                    "Đơn giá phải là số dương!");
                return;
            }

            foreach (Product p in list)
            {
                if (string.Equals(
                    p.ProductId, id,
                    StringComparison.OrdinalIgnoreCase))
                {
                    MessageBox.Show(
                        "Mã sản phẩm đã tồn tại!");
                    return;
                }
            }

            Product product = new Product();
            product.ProductId = id;
            product.ProductName = name;
            product.Price = price;

            list.Add(product);
            source.Position = list.Count - 1;

            txtId.Clear();
            txtName.Clear();
            txtPrice.Clear();

            main.SetStatus(
                "Thêm sản phẩm thành công: " + name);

            MessageBox.Show("Thêm sản phẩm thành công!");
        }

        private void BtnDelete_Click(
            object sender, EventArgs e)
        {
            Product p = source.Current as Product;

            if (p == null)
            {
                MessageBox.Show("Chưa chọn sản phẩm!");
                return;
            }

            DialogResult result = MessageBox.Show(
                "Bạn có muốn xóa " + p.ProductName + "?",
                "Xác nhận",
                MessageBoxButtons.YesNo,
                MessageBoxIcon.Question);

            if (result != DialogResult.Yes)
                return;

            string name = p.ProductName;

            source.RemoveCurrent();

            main.SetStatus("Đã xóa sản phẩm: " + name);
        }

        private void RefreshList()
        {
            source.ResetBindings(false);
            main.SetStatus("Đã làm mới danh sách sản phẩm");
        }

        private void ViewDetail()
        {
            Product p = source.Current as Product;

            if (p == null)
            {
                MessageBox.Show("Chưa chọn sản phẩm!");
                return;
            }

            MessageBox.Show(
                "Mã SP: " + p.ProductId +
                "\nTên SP: " + p.ProductName +
                "\nĐơn giá: " + p.Price.ToString("N0") +
                " VNĐ",
                "Chi tiết sản phẩm");

            main.SetStatus(
                "Đã xem sản phẩm: " + p.ProductId);
        }

        private void CreateContextMenu()
        {
            ContextMenuStrip context =
                new ContextMenuStrip();

            context.Items.Add(
                "Xóa dòng", null,
                delegate
                {
                    BtnDelete_Click(null, EventArgs.Empty);
                });

            context.Items.Add(
                "Làm mới dữ liệu", null,
                delegate
                {
                    RefreshList();
                });

            context.Items.Add(
                "Xem chi tiết", null,
                delegate
                {
                    ViewDetail();
                });

            dgv.ContextMenuStrip = context;

            dgv.CellMouseDown += delegate (
                object sender,
                DataGridViewCellMouseEventArgs e)
            {
                if (e.Button == MouseButtons.Right &&
                    e.RowIndex >= 0)
                {
                    dgv.ClearSelection();

                    dgv.CurrentCell =
                        dgv.Rows[e.RowIndex].Cells[0];

                    dgv.Rows[e.RowIndex].Selected = true;
                }
            };
        }
    }
}
